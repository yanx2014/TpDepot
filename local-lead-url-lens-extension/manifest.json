{
  "manifest_version": 3,
  "name": "Local Lead URL Lens",
  "version": "1.4.0",
  "description": "Capture LinkedIn People Search / Sales Navigator prospects and score them locally against your ICP (Job Title 65 + Job Section/Headline 20 + Location 15) with OpenAI embeddings — no backend/CRM — then download the results as a CSV.",
  "permissions": ["activeTab", "tabs", "storage", "scripting", "downloads", "alarms"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://api.openai.com/*",
    "https://dashscope-intl.aliyuncs.com/*",
    "https://dashscope.aliyuncs.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {"service_worker": "service-worker.js", "type": "module"},
  "action": {
    "default_title": "Local Lead URL Lens",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["experience-contract.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/search/results/people/*", "https://www.linkedin.com/sales/search/people*"],
      "js": ["search-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["panel.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [{"resources": ["icons/*.png"], "matches": ["https://www.linkedin.com/*"]}]
}
